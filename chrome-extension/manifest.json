{
  "manifest_version": 3,
  "name": "LinkedIn OneInbox Connector",
  "version": "1.0.0",
  "description": "Automatically connects your LinkedIn account to the central Sales Inbox platform.",
  "permissions": [
    "cookies",
    "activeTab"
  ],
  "host_permissions": [
    "https://*.linkedin.com/*",
    "https://linkedin.snapsec.co/*",
    "http://localhost:5000/*",
    "http://127.0.0.1:5000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Connect LinkedIn Account"
  }
}
